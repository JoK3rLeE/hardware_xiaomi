android_app {
    name: "XiaomiParts",

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "SettingsLib",
        "SpaLib",
        "org.lineageos.settings.resources",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
    ],
}
